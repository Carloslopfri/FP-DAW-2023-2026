<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE PanelDeVuelos [
    <!ELEMENT PanelDeVuelos (Aeropuerto, Fecha, Vuelo+)>
    <!ELEMENT Aeropuerto (#PCDATA)>
    <!ELEMENT Fecha (#PCDATA)>
    <!ELEMENT Vuelo (Codigo, Diario, Origen, Destino, HoraSalida, HoraLlegada, Estado)>
    <!ELEMENT Codigo (#PCDATA)>
    <!ELEMENT Diario (#PCDATA)>
    <!ELEMENT Origen (#PCDATA)>
    <!ELEMENT Destino (#PCDATA)>
    <!ELEMENT HoraSalida (#PCDATA)>
    <!ELEMENT HoraLlegada (#PCDATA)>
    <!ELEMENT Estado (#PCDATA)>
    <!ATTLIST Codigo
        uniqueID ID #REQUIRED>
    <!ATTLIST Diario
        valor (SI|NO) #REQUIRED>
    <!ATTLIST Estado
        valor (C|E|R) "E">
]>

